0070 758091           58             MOV P0, #91H            ; DC Motor ON, Stepper 1001
0073 11F5             59             ACALL MOTOR_DELAY
0075 20971A           60             JB P1.7, STOP_GANTRY    ; Check Y-Row 1 Limit Switch
                      61     
