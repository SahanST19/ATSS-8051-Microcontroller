00AC 11FE             96             ACALL GRIP_DELAY        ; Wait for pressure to build
                      97     
00AE                  98     RAISE_Z:
                      99             ; Step Mz Motor Upwards to safe height
                     100     
                     101             ; Phase 4: Delivery (Conveyor Belt)
00AE                 102     DELIVER_TIRE:
00AE C2A4            103             CLR P2.4                ; Turn OFF Gripper (Release Tire)
                     104     
00B0                 105     CONVEYOR_RUN:
00B0 D282            106             SETB P0.2               ; Mc Motor ON (Forward)
00B2 C283            107             CLR P0.3
00B4 11F0            108             ACALL PWM_HALF_DELAY    ; Delay for ON time
00B6 C282            109             CLR P0.2                ; Mc Motor OFF
00B8 11F0            110             ACALL PWM_HALF_DELAY    ; Delay for OFF time (50% Duty Cycle)
                     111             
00BA 30A7F3          112             JNB P2.7, CONVEYOR_RUN  ; Continue running if Conveyor IR (P2.7) is 0
                     113             
