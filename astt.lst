0030                   8             ORG 0030H
0030                   9     MAIN:
                      10             ; Initialize System Ports
0030 758000           11             MOV P0, #00H            ; Turn off all motors initially
0033 7590FF           12             MOV P1, #0FFH           ; Configure P1 as input (Keypad & Sensors)
0036 75A000           13             MOV P2, #00H            ; Turn off Actuators and Indicators
0039 75B0FF           14             MOV P3, #0FFH           ; Configure P3 as input (Buttons/Interrupts)
                      15     
                      16             ; Configure Interrupts
003C D288             17             SETB IT0                ; Set INT0 as falling-edge triggered
003E D2A8             18             SETB EX0                ; Enable External Interrupt 0
0040 D2AF             19             SETB EA                 ; Enable Global Interrupts
                      20     
                      21             ; Configure Timers (Timer 0 for Ultrasonic, Timer 1 for PWM/Delay)
0042 758911           22             MOV TMOD, #11H          ; Timer 0 and Timer 1 in 16-bit mode
                      23     
0045                  24     SYSTEM_IDLE:
0045 D2A5             25             SETB P2.5               ; Turn ON Green Light (System Ready)
0047 D2A6             26             SETB P2.6               ; Ensure Red Light/Alarm is OFF (Active-Low)
                      27             
0049                  28     WAIT_START:
0049 20B6FD           29             JB P3.6, WAIT_START     ; Wait until ON button (P3.6) is pressed
                      30     
                      31             ; Phase 1: User Input (Keypad Scanning)
004C                  32     READ_KEYPAD:
004C 7590FF           33             MOV P1, #0FFH           ; Configure P1 as input
004F C290             34             CLR P1.0                ; Ground keypad rows 0-3
0051 C291             35             CLR P1.1
0053 C292             36             CLR P1.2
0055 C293             37             CLR P1.3
                      38             
0057 E590             39             MOV A, P1
0059 5470             40             ANL A, #070H            ; Mask keypad columns (P1.4, P1.5, P1.6)
005B B47002           41             CJNE A, #070H, KEY_PRESS ; If a key is pressed, proceed
005E 80EC             42             SJMP READ_KEYPAD        ; Otherwise, keep waiting here endlessly
                      43             
0060                  44     KEY_PRESS:
0060 3103             45             ACALL DEBOUNCE_DELAY
0062 E590             46             MOV A, P1
0064 5470             47             ANL A, #070H
0066 B47002           48             CJNE A, #070H, STORE_KEY ; Confirm key press
0069 80E1             49             SJMP READ_KEYPAD
                      50     
006B                  51     STORE_KEY:
006B 7D01             52             MOV R5, #01H            ; Store target location ID
006D 020070           53             LJMP MOVE_GANTRY        ; Proceed to gantry movement after valid key
                      54     
                      55             ; Phase 2: Gantry Positioning (X and Y Axis)
0070                  56     MOVE_GANTRY:
0070                  57     Y_STEP_LOOP:
